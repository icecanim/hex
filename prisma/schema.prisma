generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Basvuru {
  id         String   @id @default(cuid())
  tur        String
  discordId  String
  discordAd  String?
  veriler    String
  durum      String   @default("beklemede")
  onaylayan  String?
  mulakat    String?
  notlar     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  discordId String   @unique
  isim      String?
  rol       String   @default("admin")
  createdAt DateTime @default(now())
}

model Duyuru {
  id        String   @id @default(cuid())
  baslik    String
  icerik    String
  gonderen  String
  createdAt DateTime @default(now())
}

model BasvuruAyar {
  id        String   @id @default(cuid())
  tur       String   @unique
  acik      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model BasvuruLog {
  id         String   @id @default(cuid())
  discordId  String
  tur        String
  islem      String
  detay      String?
  ceza       String?
  createdAt  DateTime @default(now())
}

model Icerik {
  id        String   @id @default(cuid())
  key       String   @unique
  deger     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model KuralKategori {
  id        String   @id @default(cuid())
  baslik    String
  sira      Int      @default(0)
  maddeler  KuralMadde[]
  createdAt DateTime @default(now())
}

model KuralMadde {
  id          String   @id @default(cuid())
  kategoriId  String
  icerik      String
  sira        Int      @default(0)
  kategori    KuralKategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model EkipUye {
  id        String   @id @default(cuid())
  isim      String
  rol       String
  ikon      String   @default("👤")
  renk      String   @default("from-amber-500 to-amber-700")
  sira      Int      @default(0)
  createdAt DateTime @default(now())
}

model MarketUrun {
  id        String   @id @default(cuid())
  isim      String
  aciklama  String
  fiyat     Int
  ozellikler String  @default("")
  ikon      String   @default("🛒")
  renk      String   @default("from-amber-500 to-amber-700")
  populer   Boolean  @default(false)
  sira      Int      @default(0)
  createdAt DateTime @default(now())
}

model BasvuruDeneme {
  id           String    @id @default(cuid())
  discordId    String
  tur          String
  denemeSayisi Int       @default(1)
  sonDeneme    DateTime  @default(now())
  banli        Boolean   @default(false)
  banBitis     DateTime?
  banSebep     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([discordId, tur])
}
model Ban {
  id              String    @id @default(cuid())
  discordId       String?
  steamId         String?
  sebep           String
  banlayan        String
  banBitis        DateTime?
  kalici          Boolean   @default(false)
  kaldirildi      Boolean   @default(false)
  kaldiranId      String?
  kaldirmaTarihi  DateTime?
  createdAt       DateTime  @default(now())
}